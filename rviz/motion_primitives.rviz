Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: map
      Value: true
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Show Axes: true
      Show Names: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /xm/mpl_library_markers
      Name: MPL Library
      Namespaces:
        mpl_paths: true
        mpl_endpoints: true
        mpl_action_ids: true
        x_forward: true
        y_left: true
        z_up: true
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /xm/markers
      Name: UAV Markers
      Queue Size: 100
      Value: true
    - Alpha: 1
      Class: rviz/Odometry
      Enabled: true
      Keep: 100
      Name: UAV Odometry
      Position Tolerance: 0.1
      Shape: Arrow
      Topic: /xm/odom
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 8
      Focal Point:
        X: 2.0
        Y: 0
        Z: 0.5
      Name: Current View
      Pitch: 0.55
      Target Frame: base_link
      Yaw: 4.0
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
