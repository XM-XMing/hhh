<?xml version="1.0"?>
<package format="2">
  <name>planning</name>
  <version>0.10.2</version>
  <description>Unity forest UAV planning with 3 m/s motion primitives, exact offline teacher labels, behavior cloning, and BC-initialized discrete AWAC.</description>

  <maintainer email="xm@example.com">xm</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>roslib</build_depend>
  <build_depend>tf2</build_depend>
  <build_depend>tf2_ros</build_depend>
  <build_depend>visualization_msgs</build_depend>
  <build_depend>message_generation</build_depend>
  <build_depend>libzmq3-dev</build_depend>
  <build_depend>libmsgpack-dev</build_depend>
  <build_depend>libssl-dev</build_depend>
  <build_depend>python3-setuptools</build_depend>

  <build_export_depend>roscpp</build_export_depend>
  <build_export_depend>rospy</build_export_depend>
  <build_export_depend>std_msgs</build_export_depend>
  <build_export_depend>sensor_msgs</build_export_depend>
  <build_export_depend>geometry_msgs</build_export_depend>
  <build_export_depend>nav_msgs</build_export_depend>
  <build_export_depend>roslib</build_export_depend>
  <build_export_depend>visualization_msgs</build_export_depend>
  <build_export_depend>tf2_ros</build_export_depend>
  <build_export_depend>tf2</build_export_depend>
  <build_export_depend>libzmq3-dev</build_export_depend>
  <build_export_depend>libmsgpack-dev</build_export_depend>
  <build_export_depend>libssl-dev</build_export_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>roslib</exec_depend>
  <exec_depend>tf2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>libzmq3-dev</exec_depend>
  <exec_depend>libmsgpack-dev</exec_depend>
  <exec_depend>libssl-dev</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <planning
      collision_backend="cpp_cpu"
      collision_backend_contract_id="cpp_bitmap_openmp"
      collision_source_id="planning_collision_checker_cpp17_openmp"
      depth_safety_backend="cpp_native"
      depth_safety_contract_id="cpp_depth_patch"
      depth_safety_library="libplanning_depth_safety.so"
      depth_safety_source_id="planning_depth_safety_cpp17"
    global_route_backend="cpp_native"
    global_route_contract_id="coarse_xy_astar_025m_lookahead3m_flight_band"
    global_route_library="libplanning_global_route.so"
    global_route_source_id="planning_global_route_cpp17"
    bridge_binary="unity_bridge_node"
    bridge_owner="BridgeNode"
    bridge_implementation="split"
    bridge_protocol_schema="4"
    bridge_source_manifest="python/planning/runtime/bridge_identity.py" />
  </export>
</package>
